# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Any OpenAI-compatible provider works (anything with /v1/chat/completions).
OPENAI_API_KEY=paste_your_key_here
# Base URL of the provider (default https://api.openai.com/v1):
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1
#   Ollama      http://localhost:11434/v1   (no key needed)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Model name as the provider spells it (default gpt-4.1-mini):
# OPENAI_MODEL=gpt-4.1-mini
# The web app's Settings page can send a key, URL and model with each request instead.
